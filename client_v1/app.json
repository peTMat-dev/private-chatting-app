{
  "name": "CubCha",
  "displayName": "CubCha",
  "slug": "cubcha",
  "scheme": "cubcha",
  "version": "1.0.0",
  "orientation": "portrait",
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.cubcha.app"
  },
  "android": {
    "package": "com.cubcha.app",
    "adaptiveIcon": {
